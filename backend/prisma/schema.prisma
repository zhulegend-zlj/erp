// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  boss
  purchase
  warehouse
  sales
  finance
  engineer
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
}

model Customer {
  id                  Int               @id @default(autoincrement())
  name                String
  country             String?
  contact             String?
  // 单证字段：收货地址/增值税号/EORI/通知方（出单时自动带出）
  address             String?
  vatNo               String?
  eori                String?
  notifyParty         String?
  // 单证默认值（新建订单/出货时自动带出，可改）
  defaultPaymentTerms String?
  defaultIncoterm     String?
  defaultMark         String?
  defaultTaxRate      String?
  createdAt           DateTime          @default(now())
  orders              SalesOrder[]
  customerPayments    CustomerPayment[]
}

model Supplier {
  id                   Int               @id @default(autoincrement())
  name                 String
  contact              String?
  createdAt            DateTime          @default(now())
  purchaseOrders       PurchaseOrder[]
  supplierPayments     SupplierPayment[]
  parts                Part[]
  returnReplenishments ReturnReplenish[]
  receipts             Receipt[]
}

model Product {
  id                Int                @id @default(autoincrement())
  sku               String             @unique
  name              String
  nameEn            String? // 英文品名（发票/装箱单 Description 列）
  hsCode            String? // 海关编码
  unit              String             @default("件")
  imageUrl          String?
  boms              Bom[]
  orderItems        SalesOrderItem[]
  productionEntries ProductionEntry[]
  shipmentLines     ShipmentLine[]
  schedules         ShipmentSchedule[]
}

model Part {
  id                   Int                 @id @default(autoincrement())
  sku                  String              @unique
  name                 String
  nameEn               String? // 英文品名
  unit                 String              @default("个")
  spec                 String?
  weight               String? // 重量(g)（表格中为文本，含 g/中文备注，故用字符串）
  revision             String? // 版本
  material             String? // 材质
  dimensions           String? // 尺寸规格
  finish               String? // 表面处理
  artId                String? // 图号 Art.ID
  imageUrl             String?
  drawingsUrl          String?
  tooling              String?
  moq                  Int?
  price                Decimal?            @db.Decimal(12, 4)
  usedIn               String? // 用在何处（暂存未展示）
  process              String? // 生产工艺（暂存未展示）
  supplier             Supplier?           @relation(fields: [supplierId], references: [id])
  supplierId           Int?
  boms                 Bom[]
  purchaseItems        PurchaseOrderItem[]
  receipts             Receipt[]
  issues               Issue[]
  returnReplenishments ReturnReplenish[]
}

model Bom {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  part      Part    @relation(fields: [partId], references: [id])
  partId    Int
  qty       Int

  @@unique([productId, partId])
}

model SalesOrder {
  id                   Int                @id @default(autoincrement())
  orderNo              String             @unique
  customer             Customer           @relation(fields: [customerId], references: [id])
  customerId           Int
  customerPoNo         String? // 客户采购订单号（必填录入，DB 可空兼容历史）
  orderDate            DateTime           @default(now()) // 订单日期（默认今天）
  customerDeliveryDate DateTime? // 客户交期（客户要求到货日）
  zrhDeliveryDate      DateTime // ZRH交货日期（承诺给客户的交货日期 = 车间完成生产目标）
  paymentTerms         String? // 付款条件（如 NET 60，默认取客户资料）
  status               String             @default("draft") // draft/confirmed/in_production/ready/shipped/completed
  // 双阶段标志（可同时为真）：采购中=存在未收齐的采购单；生产中=已开始成品入库但未收满
  purchasing           Boolean            @default(false)
  producing            Boolean            @default(false)
  otherCost            Decimal            @default(0) @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  items                SalesOrderItem[]
  purchaseOrders       PurchaseOrder[]
  issues               Issue[]
  productionEntries    ProductionEntry[]
  shipments            Shipment[]
  schedules            ShipmentSchedule[]
  shipmentLines        ShipmentLine[]
  customerPayments     CustomerPayment[]
  inventoryLedgers     InventoryLedger[]
}

model SalesOrderItem {
  id        Int        @id @default(autoincrement())
  order     SalesOrder @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product    @relation(fields: [productId], references: [id])
  productId Int
  qty       Int
  unitPrice Decimal    @db.Decimal(12, 2)

  @@unique([orderId, productId])
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  orderNo      String              @unique
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  supplierId   Int
  salesOrder   SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int?
  status       String              @default("open") // open/partial/received
  createdAt    DateTime            @default(now())
  items        PurchaseOrderItem[]
  receipts     Receipt[]
  payments     SupplierPayment[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int
  part            Part          @relation(fields: [partId], references: [id])
  partId          Int
  qty             Int
  unitPrice       Decimal       @db.Decimal(12, 2)

  @@unique([purchaseOrderId, partId])
}

model Receipt {
  id              Int            @id @default(autoincrement())
  // 自购买（无采购单）收货时 purchaseOrderId 为空，supplierId 可选挂供应商便于追溯
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int?
  part            Part           @relation(fields: [partId], references: [id])
  partId          Int
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  supplierId      Int?
  qty             Int
  lotNo           String?
  qcStatus        String?
  defectiveQty    Int            @default(0)
  receivedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
}

model Issue {
  id           Int        @id @default(autoincrement())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int
  part         Part       @relation(fields: [partId], references: [id])
  partId       Int
  qty          Int
  issuedBy     String // 生产组长姓名（不登录系统，由仓管代录）
  note         String?
  issuedAt     DateTime   @default(now())
}

model ProductionEntry {
  id           Int        @id @default(autoincrement())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int
  product      Product    @relation(fields: [productId], references: [id])
  productId    Int
  qty          Int
  entryDate    DateTime   @default(now())
}

model Shipment {
  id                   Int            @id @default(autoincrement())
  salesOrder           SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderId         Int
  shippedAt            DateTime       @default(now())
  deliveryNote         String?
  signer               String?
  remark               String?
  // 单证字段（发票/装箱单）：发票号手工填，其余按单填写
  invoiceNo            String?
  paymentTerms         String?
  incoterm             String?
  mark                 String? // 唛头（如 FANATEC）
  origin               String? // 原产地
  hsCode               String? // 海关编码（整单默认）
  taxRate              String? // 税率
  vesselVoyage         String? // 船名/航次
  etd                  DateTime?
  eta                  DateTime?
  shippingInstructions String? // 运费说明（如 ALU 1264 pcs）
  hubId                Int? // 到货仓（一单一仓）
  hub                  ShipToHub?     @relation(fields: [hubId], references: [id])
  legs                 ShipmentLeg[]
  lines                ShipmentLine[]
}

// 出货明细行：支持同一成品按柜/批次拆多行，每行记录 客户PO/Lot/箱数/毛净重/CBM/柜号/封条/HBL
model ShipmentLine {
  id           Int               @id @default(autoincrement())
  shipment     Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId   Int
  product      Product           @relation(fields: [productId], references: [id])
  productId    Int
  // 行所属订单（支持跨订单拼一票，每行带自己的客户 PO）
  salesOrderId Int?
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  // 来源排程行（从排程出货时回写，用于扣排程剩余）
  scheduleId   Int?
  schedule     ShipmentSchedule? @relation(fields: [scheduleId], references: [id])
  qty          Int
  unitPrice    Decimal           @db.Decimal(12, 2)
  customerPoNo String?
  lotNo        String?
  cartons      Int?
  netWeight    Decimal?          @db.Decimal(12, 3)
  grossWeight  Decimal?          @db.Decimal(12, 3)
  cbm          Decimal?          @db.Decimal(12, 4)
  containerNo  String?
  sealNo       String?
  hblNo        String?
  remark       String?
  sortOrder    Int               @default(0)
}

// 到货仓（客户目的地仓，如 VPC-MEL.）：下拉可选、可手填保存，销售可维护
model ShipToHub {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  createdAt DateTime           @default(now())
  schedules ShipmentSchedule[]
  shipments Shipment[]
}

// 出货排程：销售按客户 OPO 表录（订单→成品→数量→到货仓→客户要求日+承诺日），
// 状态：pending 待备货 → picked 已备好（仓库确认）→ shipped 已出货；可 cancelled 取消
model ShipmentSchedule {
  id            Int            @id @default(autoincrement())
  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderId  Int
  product       Product        @relation(fields: [productId], references: [id])
  productId     Int
  qty           Int // 剩余待出数量（出货按行扣减）
  hub           ShipToHub      @relation(fields: [hubId], references: [id])
  hubId         Int
  needByDate    DateTime // 客户要求到货日
  promisedDate  DateTime // 我方承诺日（回复客户 OPO 的 PD）
  status        String         @default("pending") // pending/picked/shipped/cancelled
  note          String?
  shipmentId    Int? // 出完时挂最后一张出货单
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shipmentLines ShipmentLine[]
}

// 公司抬头/银行/VAT 等出单资料（单例配置，老板维护）
model CompanyProfile {
  id          Int    @id @default(autoincrement())
  name        String @default("")
  address     String @default("")
  contact     String @default("")
  email       String @default("")
  vatNo       String @default("")
  taxRate     String @default("0")
  bankName    String @default("")
  bankPhone   String @default("")
  bankAddress String @default("")
  swift       String @default("")
  accountName String @default("")
  accountNo   String @default("")
}

model ShipmentLeg {
  id         Int      @id @default(autoincrement())
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId Int
  node       String // 备货/装柜/开船/到港/清关
  at         DateTime @default(now())
  note       String?
}

model SupplierPayment {
  id              Int            @id @default(autoincrement())
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  supplierId      Int
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int?
  amount          Decimal        @db.Decimal(12, 2)
  paidAt          DateTime       @default(now())
}

model CustomerPayment {
  id           Int         @id @default(autoincrement())
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   Int
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int?
  amount       Decimal     @db.Decimal(12, 2)
  receivedAt   DateTime    @default(now())
}

model Stock {
  itemType  String // part / product
  itemId    Int
  qtyOnHand Int    @default(0)

  @@id([itemType, itemId])
}

model InventoryLedger {
  id           Int         @id @default(autoincrement())
  itemType     String
  itemId       Int
  delta        Int
  balance      Int
  refType      String // receipt/issue/production/shipment/return/replenish
  refId        Int
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int?
  at           DateTime    @default(now())
}

model ReturnReplenish {
  id              Int       @id @default(autoincrement())
  part            Part      @relation(fields: [partId], references: [id])
  partId          Int
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  supplierId      Int
  returnDate      DateTime?
  returnQty       Int       @default(0)
  replenishDate   DateTime?
  replenishQty    Int       @default(0)
  purchaseOrderNo String?
  lotNo           String?
  note            String?
  createdAt       DateTime  @default(now())
}
