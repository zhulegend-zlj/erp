{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ERP（MTO 组装/贸易）后端：Fastify + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
